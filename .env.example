# -----------------------------------------------------------------------------
# Habitat environment configuration
# Copy to .env.local for development. Never commit real values.
# -----------------------------------------------------------------------------

# Postgres connection used by the server. On Supabase use the *transaction
# pooler* connection string (port 6543) for serverless deployments.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54322/habitat

# Public base URL (used in invitation links).
APP_URL=http://localhost:3000

# Signs local session cookies and local file URLs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=replace-with-a-long-random-string

# --- Supabase (optional locally, recommended in production) ------------------
# When both are set, Habitat uses Supabase Auth instead of local auth.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Enables Supabase Storage for documents. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# --- Local storage fallback --------------------------------------------------
# Used when SUPABASE_SERVICE_ROLE_KEY is not set. Must not be publicly served.
LOCAL_STORAGE_DIR=.data/uploads

# --- AI (optional) -----------------------------------------------------------
# Document extraction and Ask Habitat are disabled until a provider is set.
AI_PROVIDER=
ANTHROPIC_API_KEY=
AI_MODEL=

# Demo accounts are removed after this many hours (scripts/db.ts cleanup-demo).
DEMO_MAX_AGE_HOURS=24
